{
  "name": "cube-coach",
  "private": true,
  "description": "Cube Coach - a kid-friendly 2x2 and 3x3 Rubik's cube solving guide, one HTML file",
  "scripts": {
    "build": "python3 build.py",
    "check": "python3 build.py --check",
    "test": "node tests/run.js",
    "e2e": "python3 tests/e2e/flows.py && python3 tests/e2e/camera.py",
    "screens": "python3 tests/e2e/screens.py en"
  },
  "devDependencies": {
    "cubejs": "1.3.2",
    "sharp": "^0.34.5"
  }
}
